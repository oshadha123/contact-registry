# ─────────────────────────────────────────────────────────────────────────────
#  Contact Registry v3 — Environment variables
#  Copy to .env for local development:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# TCP port the HTTP server listens on (default: 8080)
PORT=8080

# Postgres connection string — in production, point at PgBouncer, not Postgres directly.
# Local dev (no PgBouncer):  postgres://registry:registry@localhost:5432/registry
DATABASE_URL=postgres://registry:registry@pgbouncer:5432/registry

# Redis connection URL
REDIS_URL=redis://redis:6379

# Tracing/log filter (optional — defaults shown)
RUST_LOG=webapp=debug,tower_http=info
